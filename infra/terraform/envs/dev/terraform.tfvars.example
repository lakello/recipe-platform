cloud_id  = "YCAGV1234567890"
folder_id = "YCAGV1234567890"

environment = "dev"
availability_zones = ["ru-central1-a", "ru-central1-b"]
instance_tags = {
  "env" = "dev"
  "project" = "recipe-platform"
}
public_subnet_cidr  = "10.10.1.0/24"
private_subnet_cidr = "10.10.2.0/24"
cluster_ipv4_range  = "10.20.0.0/16"

k8s_version = "1.33"

database_name     = "recipe_platform_db"
database_user     = "db_user"
database_password = "secure_password" # pragma: allowlist secret
redis_password    = "secure_redis_password" # pragma: allowlist secret

admin_cidr = ""
ssh_public_key = ""

dns_zone_name = "recipe-platform-dev."

github_oidc_audience = "recipe-platform"
github_repository    = "lakello/recipe-platform"