APP_ENV=local
APP_NAME=recipe-platform-backend

DATABASE_URL=postgresql+psycopg://recipe:recipe@localhost:5432/recipe
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=local-development-secret-not-for-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PHOTOS=recipe-photos
S3_BUCKET_AVATARS=avatars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback
